{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/17a527316d3aee46f7185c178d3b3122d8ebfd7b/crates/tauri-schema-generator/schemas/config.schema.json",
  "productName": "KoharuZen",
  "identifier": "KoharuZen",
  "build": {
    "devUrl": "http://localhost:3000",
    "frontendDist": "../../packages/koharu/out",
    "beforeDevCommand": "bun run --filter @koharu/app dev",
    "beforeBuildCommand": "bun run --filter @koharu/app build"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "create": false,
        "width": 1024,
        "height": 768,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "title": "KoharuZen",
        "decorations": false,
        "transparent": false,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "rpm", "appimage", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "license": "MIT OR Apache-2.0",
    "resources": ["../../LICENSE-MIT", "../../LICENSE-APACHE"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlFMkM0MTc5Q0NGOUNGODEKUldTQnovbk1lVUVzbm1aeU14dmZLTjV1cHgyb0QwMWJCQ05WcnBETVFKUzF1Rzc1VHJnbDcxMEQK",
      "endpoints": ["https://github.com/nawka12/KoharuZen/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
